# Vercel / 本機：於 web/ 目錄或 Vercel Project 設定
GEMINI_API_KEY=
MODEL_NAME=gemini-3.1-flash-lite
MAX_COMPLETION_TOKENS=1024
# Phase 1：Neon Postgres（Vercel Marketplace 一鍵；對話記憶／收藏／配額）
DATABASE_URL=
PLAN_FREE_DAILY_LIMIT=20
MAX_HISTORY_TURNS=2
DEFAULT_TENANT_ID=default
# PM-2：從對話萃取飲食偏好（背景寫入 personalization 表）
ENABLE_PREFERENCE_EXTRACTION=1
PREFERENCE_EXTRACTION_LLM_TIER=1
PREFERENCE_CONFIDENCE_THRESHOLD=0.7
PREFERENCE_EXTRACTION_TIMEOUT_SEC=8
# PM-3：生成食譜時注入個人化區塊
ENABLE_PERSONALIZATION_INJECTION=1
PERSONALIZATION_MAX_TOKENS=350
PERSONALIZATION_LOAD_TIMEOUT_SEC=1.5
# PM-4：口味檔案 UI + onboarding
ENABLE_PERSONALIZATION_UI=1
ENABLE_ONBOARDING_FLOW=1
ONBOARDING_RETRY_MAX=2
SHOW_APPLIED_PERSONALIZATION=1
# PT-1：冰箱庫存資料層（尚無 UI；migration 0013）
ENABLE_PANTRY=1
PANTRY_DEFAULT_EXPIRY_DAYS=7
PANTRY_EXPIRY_WARN_DAYS=3
# PT-2：冰箱／收據 Vision 辨識
ENABLE_PANTRY_VISION=1
PANTRY_VISION_USER_DAILY_LIMIT=20
PANTRY_VISION_CACHE_TTL_SEC=3600
PANTRY_REVIEW_TTL_SEC=1800
PANTRY_VISION_LOW_CONFIDENCE_THRESHOLD=0.5
PANTRY_VISION_HIGH_CONFIDENCE_THRESHOLD=0.8
AI_VISION_TIMEOUT_SEC=20
IMAGE_INTENT_TIMEOUT_SEC=6
# PT-3：冰箱查詢 UI、清冰箱連動、食譜 ✓ 標註
SHOW_PANTRY_ANNOTATIONS_ON_RECIPE=1
PANTRY_ANNOTATION_TIMEOUT_MS=500
CLEAN_FRIDGE_USE_PANTRY=1
PANTRY_FLEX_ITEMS_PER_GROUP=5
# PT-4：效期提醒、用完它、週報（App 收件匣；Vercel Cron 每小時觸發）
ENABLE_EXPIRY_REMINDERS=1
ENABLE_WEEKLY_DIGEST=1
ENABLE_USE_IT_UP=1
NOTIFICATION_CRON_SECRET=
NOTIFICATION_MAX_PUSHES_PER_SWEEP=1000
NOTIFICATION_CONCURRENCY=10
NOTIFICATION_IGNORE_BACKOFF_THRESHOLD=3
NOTIFICATION_IGNORE_BACKOFF_DAYS=14
USE_IT_UP_FULL_RECIPES_COUNT=1
USE_IT_UP_CANDIDATE_MAX_TOKENS=400
USE_IT_UP_CANDIDATE_TIMEOUT_SEC=10
# LOG_USER_HASH_SALT=
# MP-1：週菜單規劃（資料層 + 兩段式演算法，尚無 UI）
ENABLE_MEAL_PLANNING=1
MEAL_PLAN_MAX_DAYS=14
MEAL_PLAN_DEFAULT_DAYS=7
MEAL_PLAN_LLM_MAX_TOKENS=2500
MEAL_PLAN_LLM_TIMEOUT_SEC=30
MEAL_PLAN_MAX_REPAIR_ITERATIONS=2
MEAL_PLAN_DEFAULT_BUDGET_TWD=1500
MEAL_PLAN_WEEKDAY_MAX_TIME=30
MEAL_PLAN_WEEKEND_MAX_TIME=60
# 營運指標（選填）；未設定時 GET /api/metrics 回 503
# METRICS_TOKEN=
# 主圖：placeholder（備援圖）或 openai_compatible（需 OPENAI_API_KEY 或 IMAGE_OPENAI_API_KEY）
IMAGE_PROVIDER=placeholder
# 自動生成主圖（0=關閉；預設開啟，使用者可在「我的」關閉）
# AUTO_HERO_IMAGE=1
# RECIPE_FALLBACK_HERO_IMAGE_URL=https://example.com/hero.jpg
# OPENAI_API_KEY=
# IMAGE_OPENAI_API_KEY=
# 顯示與配額「今日」邊界（預設 Asia/Taipei）
# NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Taipei
# 步驟插圖：預設不自動生成；設 1 才在背景批次產生（不建議）
AUTO_STEP_IMAGES=0
# 每道食譜最多自動步驟圖數（僅 AUTO_STEP_IMAGES=1 時）
# MAX_STEP_IMAGES=6
# Analytics（選填）：不可送出完整 prompt、分享 token 或自訂過敏食材
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_ANALYTICS_ENABLED=1
# Wave 2：今晚清冰箱清單（localStorage + 生成 prompt）
# NEXT_PUBLIC_PANTRY_TONIGHT=1
# Wave 3：週菜單與採買（側欄 Plan／Shopping）
# NEXT_PUBLIC_MEAL_PLAN_ENABLED=1
# NEXT_PUBLIC_COOKING_MODE_ENABLED=1
# NEXT_PUBLIC_NEW_UI=1
# NEXT_PUBLIC_SITE_URL=https://your-production.vercel.app
# MP-2：週菜單規劃 UI（/app/plan AI 分頁；需 ENABLE_MEAL_PLANNING=1）
ENABLE_MEAL_PLAN_UI=1
NEXT_PUBLIC_MEAL_PLAN_AI_ENABLED=1
MEAL_PLAN_GENERATION_USER_TIMEOUT_SEC=90
MEAL_PLAN_FREE_TIER_PER_MONTH=2
MEAL_PLAN_SWAP_CANDIDATES_COUNT=3
MEAL_PLAN_SWAP_LLM_TIMEOUT_SEC=15
