# Vercel / 本機：於 web/ 目錄或 Vercel Project 設定
GEMINI_API_KEY=
MODEL_NAME=gemini-3.1-flash-lite
MAX_COMPLETION_TOKENS=1024
# Phase 1：Neon Postgres（Vercel Marketplace 一鍵；對話記憶／收藏／配額）
DATABASE_URL=
PLAN_FREE_DAILY_LIMIT=20
MAX_HISTORY_TURNS=2
DEFAULT_TENANT_ID=default
# 主圖：placeholder（備援圖）或 openai_compatible（需 OPENAI_API_KEY 或 IMAGE_OPENAI_API_KEY）
IMAGE_PROVIDER=placeholder
# 自動生成主圖（0=關閉；預設開啟，使用者可在「我的」關閉）
# AUTO_HERO_IMAGE=1
# RECIPE_FALLBACK_HERO_IMAGE_URL=https://example.com/hero.jpg
# OPENAI_API_KEY=
# IMAGE_OPENAI_API_KEY=
# 顯示與配額「今日」邊界（預設 Asia/Taipei）
# NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Taipei
# 步驟插圖：預設不自動生成；設 1 才在背景批次產生（不建議）
AUTO_STEP_IMAGES=0
# 每道食譜最多自動步驟圖數（僅 AUTO_STEP_IMAGES=1 時）
# MAX_STEP_IMAGES=6
