{
  "name": "@chef/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm -F @chef/design-tokens build && next build",
    "build:e2e": "pnpm -F @chef/design-tokens build && NEXT_PUBLIC_COOKING_MODE_ENABLED=1 NEXT_PUBLIC_SHARING_ENABLED=1 NEXT_PUBLIC_ENABLE_PWA=0 NEXT_PUBLIC_ANALYTICS_ENABLED=0 next build",
    "start": "next start",
    "prepare:standalone": "cp -R public .next/standalone/web/public && cp -R .next/static .next/standalone/web/.next/static",
    "start:standalone": "node .next/standalone/web/server.js",
    "lint": "tsc --noEmit && eslint .",
    "lint:eslint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "tsx scripts/migrate.ts",
    "audit:hero-persistence": "tsx scripts/audit-hero-persistence.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "marketing:images": "tsx scripts/generate-marketing-images.ts"
  },
  "dependencies": {
    "@chef/design-tokens": "workspace:*",
    "@chef/shared-types": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@serwist/next": "^9.5.11",
    "@vercel/functions": "^3.6.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^1.16.0",
    "next": "^15.1.0",
    "openai": "^4.77.0",
    "postcss": "^8.5.15",
    "posthog-js": "^1.249.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.18",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.0.0"
  }
}
