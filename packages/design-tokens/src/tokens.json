{
  "$schema": "https://design-tokens.org/schemas/dtcg-v1.json",
  "meta": {
    "name": "chef-ai-warm-bright",
    "version": "0.1.0",
    "description": "職人料理大腦 Web：米白 + 琥珀金 + 深森綠"
  },
  "color": {
    "background": {
      "default": { "$type": "color", "$value": { "light": "#FFFAF5", "dark": "#FFFAF5" } },
      "alt": { "$type": "color", "$value": { "light": "#F9F7F4", "dark": "#F9F7F4" } }
    },
    "surface": {
      "default": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#FFFFFF" } },
      "alt": { "$type": "color", "$value": { "light": "#F5EFE6", "dark": "#F5EFE6" } },
      "muted": { "$type": "color", "$value": { "light": "#F9F4EE", "dark": "#F9F4EE" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "light": "#EAE4DC", "dark": "#EAE4DC" } }
    },
    "brand": {
      "primary": { "$type": "color", "$value": { "light": "#C8922A", "dark": "#C8922A" } },
      "primaryDark": { "$type": "color", "$value": { "light": "#A67318", "dark": "#A67318" } },
      "primaryLight": { "$type": "color", "$value": { "light": "#FDF6E7", "dark": "#FDF6E7" } },
      "green": { "$type": "color", "$value": { "light": "#2A6049", "dark": "#2A6049" } },
      "greenLight": { "$type": "color", "$value": { "light": "#EBF5F0", "dark": "#EBF5F0" } },
      "greenText": { "$type": "color", "$value": { "light": "#F5F0E6", "dark": "#F5F0E6" } },
      "purple": { "$type": "color", "$value": { "light": "#7B5EA7", "dark": "#7B5EA7" } }
    },
    "text": {
      "ink": { "$type": "color", "$value": { "light": "#1C1917", "dark": "#1C1917" } },
      "body": { "$type": "color", "$value": { "light": "#3D3530", "dark": "#3D3530" } },
      "muted": { "$type": "color", "$value": { "light": "#9C8F84", "dark": "#9C8F84" } }
    },
    "cuisine": {
      "taiwanese": { "$type": "color", "$value": { "light": "#6B3A2A", "dark": "#6B3A2A" } },
      "thai": { "$type": "color", "$value": { "light": "#2A5C3F", "dark": "#2A5C3F" } },
      "japanese": { "$type": "color", "$value": { "light": "#3A2A4A", "dark": "#3A2A4A" } },
      "european": { "$type": "color", "$value": { "light": "#2A3A4A", "dark": "#2A3A4A" } },
      "kids": { "$type": "color", "$value": { "light": "#6B5A2A", "dark": "#6B5A2A" } }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "-apple-system, BlinkMacSystemFont, 'PingFang TC', 'Microsoft JhengHei', sans-serif"
      }
    },
    "size": {
      "base": { "$type": "dimension", "$value": "15px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "22px" }
    }
  },
  "spacing": {
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "24px" }
  },
  "shadow": {
    "md": { "$type": "shadow", "$value": "0 4px 12px rgba(28, 25, 23, 0.08)" }
  },
  "motion": {
    "duration": {
      "normal": { "$type": "duration", "$value": "200ms" }
    }
  }
}
