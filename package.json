{
  "name": "chef-ai-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm -F @chef/web dev",
    "lint": "pnpm -r lint",
    "tokens:build": "pnpm -F @chef/design-tokens build",
    "tokens:watch": "pnpm -F @chef/design-tokens build --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
